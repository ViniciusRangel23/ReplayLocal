<UserControl x:Class="Kairos.Ui.PictureViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairos.Ui"
             Focusable="False">
    <!-- A screenshot at full size over the window: copy, share, show in folder, delete. Esc or a click outside closes. -->
    <Grid x:Name="Scrim" Background="#E01A1514" MouseLeftButtonDown="OnScrimClick">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="28,44,20,10" WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Meta" Style="{StaticResource Caption}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
            </StackPanel>
            <Button x:Name="EditButton" Grid.Column="1" Style="{StaticResource Ghost}" Click="OnEdit" Padding="14,9" Margin="0,0,8,0"
                    AutomationProperties.Name="{l:T viewer.edit}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T viewer.edit}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource Ghost}" Padding="11,9" Click="OnClose"
                    ToolTip="{l:T viewer.close}" AutomationProperties.Name="{l:T viewer.close}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="13"/>
            </Button>
        </Grid>

        <!-- The pictures before and after this one on the Library page (arrow keys too) -->
        <Grid Grid.Row="1" Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PrevButton" Style="{StaticResource Ghost}" Click="OnPrev" Padding="12,14" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:T viewer.previous}" AutomationProperties.Name="{l:T viewer.previous}">
                <TextBlock x:Name="PrevIcon" Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="14"/>
            </Button>
            <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource Ghost}" Click="OnNext" Padding="12,14" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:T viewer.next}" AutomationProperties.Name="{l:T viewer.next}">
                <TextBlock x:Name="NextIcon" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="14"/>
            </Button>
        <!-- Never mirrored: a picture reads the same in Arabic -->
        <Border Grid.Column="1" Margin="16,0" CornerRadius="10" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{StaticResource Stroke}" BorderThickness="1" MouseLeftButtonDown="OnPictureClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <Image x:Name="Picture" Stretch="Uniform" FlowDirection="LeftToRight" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="{Binding Text, ElementName=Heading}"/>
        </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,24" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource Primary}" Click="OnShare" Padding="18,9" Margin="0,0,8,0" AutomationProperties.Name="{l:T clips.share}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T clips.share}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Ghost}" Click="OnCopy" Padding="16,9" Margin="0,0,8,0" AutomationProperties.Name="{l:T viewer.copy}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CopyIcon" Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CopyLabel" Text="{l:T viewer.copy}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Ghost}" Click="OnShow" Padding="16,9" Margin="0,0,8,0" AutomationProperties.Name="{l:T clips.show}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T clips.show}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Ghost}" Click="OnDelete" Padding="16,9" AutomationProperties.Name="{l:T clips.recycle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="{l:T clips.recycle}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

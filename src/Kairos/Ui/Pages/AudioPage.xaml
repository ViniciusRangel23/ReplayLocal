<UserControl x:Class="Kairos.Ui.Pages.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairos.Ui">
    <StackPanel>
        <TextBlock Style="{StaticResource Title}" Text="{l:T nav.audio}"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:T audio.appsTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseApplicationAudio}" HorizontalAlignment="Right" AutomationProperties.Name="{l:T audio.appsTitle}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T audio.appsHint}"/>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding AudioValidationMessage}"/>
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T audio.gameSound}"/>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding GameAudioEnabled}" IsEnabled="{Binding CanToggleGameAudio}" AutomationProperties.Name="{l:T audio.gameSound}"/>
                        <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="×" Foreground="{StaticResource Danger}" Margin="8,0,0,0" IsEnabled="{Binding HasGameAudio}"
                                Command="{Binding RemoveAudioApplicationCommand}" CommandParameter="{Binding GameAudioRow}" AutomationProperties.Name="{l:T audio.removeApp}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding GameTargetLabel}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding GameStatusLabel}" TextWrapping="Wrap" MinHeight="36"/>
                    <l:LevelBar x:Name="GameMeter" Height="12" ExternalDb="{Binding GamePeakDb}" IsMonitoringActive="{Binding GameMeterActive}" Margin="0,12,0,0" AutomationProperties.Name="{l:T audio.feedback.level}"/>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding SignalText, ElementName=GameMeter}" Margin="0,5,0,12"/>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T audio.volume}"/>
                    <Grid IsEnabled="{Binding GameAudioEnabled}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="200" Value="{Binding GameAudioVolume}" AutomationProperties.Name="{l:T audio.volume}"/>
                        <TextBlock Grid.Column="1" Text="{Binding GameAudioVolume, StringFormat={}{0:0}%}" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Text="{l:T audio.gameHint}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T audio.mic}"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Mic}" IsEnabled="{Binding CanToggleMicrophone}" HorizontalAlignment="Right" AutomationProperties.Name="{l:T audio.mic}"/>
                    </DockPanel>
                    <ComboBox ItemsSource="{Binding Mics}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MicDevice}" AutomationProperties.Name="{l:T audio.device}" Margin="0,0,0,5"/>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding MicStatusLabel}" TextWrapping="Wrap"/>
                    <l:LevelBar x:Name="MicMeter" Channel="mic" Height="12" IsMonitoringActive="{Binding MicMeterActive}" Margin="0,12,0,0" AutomationProperties.Name="{l:T audio.feedback.level}"/>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding SignalText, ElementName=MicMeter}" Margin="0,5,0,12"/>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T audio.volume}"/>
                    <Grid IsEnabled="{Binding Mic}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="200" Value="{Binding MicVolume}" IsSnapToTickEnabled="True" TickFrequency="5" AutomationProperties.Name="{l:T audio.volume}"/>
                        <TextBlock Grid.Column="1" Text="{Binding MicVolume, StringFormat={}{0:0}%}" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <Border Style="{StaticResource Card}" Visibility="{Binding UseApplicationAudio, Converter={StaticResource Vis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{l:T audio.feedback.apps}"/>
                    <Grid Margin="0,14,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding AudioCandidates}" DisplayMemberPath="Target.ExecutableName" SelectedItem="{Binding SelectedAudioCandidate}"
                                  AutomationProperties.Name="{l:T audio.selectApp}"/>
                        <Button Grid.Column="1" Style="{StaticResource Primary}" Content="{l:T audio.addApp}" Command="{Binding AddAudioApplicationCommand}" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="{l:T audio.refreshApps}" Command="{Binding RefreshCapsCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding AppAudioRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="{l:T audio.trackName}" Margin="0,0,12,0"/>
                                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" AutomationProperties.Name="{l:T audio.recordSource}"/>
                                            <Button Grid.Column="2" Style="{StaticResource Ghost}" Margin="8,0,0,0" Content="×" Foreground="{StaticResource Danger}"
                                                    Command="{Binding DataContext.RemoveAudioApplicationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{l:T audio.removeApp}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding TargetLabel}"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding StateLabel}"/>
                                        <l:LevelBar x:Name="AppMeter" Height="12" ExternalDb="{Binding PeakDb}" IsMonitoringActive="{Binding MeterActive}" Margin="0,8,0,0" AutomationProperties.Name="{l:T audio.feedback.level}"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SignalText, ElementName=AppMeter}" Margin="0,5,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                                            <Slider Minimum="0" Maximum="200" Value="{Binding VolumePercent}" IsEnabled="{Binding Enabled}" AutomationProperties.Name="{l:T audio.volume}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding VolumePercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Style="{StaticResource Label}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" Text="{l:T audio.recordingLevelsHint}"/>
                    <TextBlock Style="{StaticResource Caption}" Text="{l:T audio.bufferRestartHint}" Foreground="{StaticResource Warning}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding UseLegacyAudio, Converter={StaticResource Vis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Section}" Text="{l:T audio.system}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding AudioSystem}" AutomationProperties.Name="{l:T audio.system}"/>
                </Grid>
                <l:LevelBar Channel="system" Margin="30,12,0,0" Visibility="{Binding AudioSystem, Converter={StaticResource Vis}}" AutomationProperties.Name="{l:T audio.level}"/>
                <StackPanel IsEnabled="{Binding AudioSystem}" Margin="30,14,0,0">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{l:T audio.device}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Speakers}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SystemDevice}" AutomationProperties.Name="{l:T audio.device}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="272"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{l:T audio.volume}"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding SystemVolume}" IsSnapToTickEnabled="True" TickFrequency="5"
                                VerticalAlignment="Center" AutomationProperties.Name="{l:T audio.volume}"/>
                        <TextBlock Grid.Column="2" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Run Text="{Binding SystemVolume, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{l:T audio.cardOptions}"/>
                <Grid ToolTip="{l:T audio.separateTip}" Visibility="{Binding UseLegacyAudio, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Label}" Text="{l:T audio.separate}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T audio.separateTip}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SeparateTracks}" AutomationProperties.Name="{l:T audio.separate}"/>
                </Grid>
                <Border Style="{StaticResource Divider}"/>
                <Grid IsEnabled="{Binding SourceAudioPossible}" Visibility="{Binding UseLegacyAudio, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Label}" Text="{l:T audio.sourceOnly}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T audio.sourceOnlyTip}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SourceAudioOnly}" AutomationProperties.Name="{l:T audio.sourceOnly}"/>
                </Grid>
                <Border Style="{StaticResource Divider}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T audio.bitrate}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AudioBitrates}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding AudioBitrate}" AutomationProperties.Name="{l:T audio.bitrate}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

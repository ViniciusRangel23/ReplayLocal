<UserControl x:Class="Kairos.Ui.TrimBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kairos.Ui"
             FlowDirection="LeftToRight" Height="50" Focusable="False" SnapsToDevicePixels="True">
    <!-- Time runs left to right in every language. The handles sit just outside the cut, so 12 px of room on each side. -->
    <UserControl.Resources>
        <!-- A keyboard-focused handle gets a white outline -->
        <Style x:Key="Handle" TargetType="Border">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- A click or drag on the strip moves the playhead (inside the cut) -->
    <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnStripDown">
        <Border x:Name="StripBox" Margin="12,4" CornerRadius="5" Background="#231D1C" ClipToBounds="True">
            <ItemsControl x:Name="Strip" Focusable="False" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Canvas x:Name="Overlay">
            <Rectangle x:Name="ShadeLeft" Fill="#C0201A19" IsHitTestVisible="False"/>
            <Rectangle x:Name="ShadeRight" Fill="#C0201A19" IsHitTestVisible="False"/>
            <!-- The cut: drag its middle to move it (a plain click there moves the playhead) -->
            <Border x:Name="Range" BorderBrush="{DynamicResource Accent}" BorderThickness="0,2.5" Background="Transparent" Cursor="SizeAll"
                    MouseLeftButtonDown="OnRangeDown"/>
            <!-- Playhead: where the playback is -->
            <Grid x:Name="PlayheadMark" Width="12" IsHitTestVisible="False" Visibility="Collapsed">
                <Rectangle Width="2" HorizontalAlignment="Center" Fill="White" RadiusX="1" RadiusY="1">
                    <Rectangle.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8" Color="Black"/>
                    </Rectangle.Effect>
                </Rectangle>
            </Grid>
            <Border x:Name="StartHandle" Style="{StaticResource Handle}" Width="12" CornerRadius="6,0,0,6" Background="{DynamicResource Accent}" Cursor="SizeWE"
                    Focusable="True" FocusVisualStyle="{x:Null}" MouseLeftButtonDown="OnStartDown" KeyDown="OnStartKey"
                    AutomationProperties.Name="{l:T share.trimStart}">
                <Rectangle Width="2" Height="16" RadiusX="1" RadiusY="1" Fill="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="EndHandle" Style="{StaticResource Handle}" Width="12" CornerRadius="0,6,6,0" Background="{DynamicResource Accent}" Cursor="SizeWE"
                    Focusable="True" FocusVisualStyle="{x:Null}" MouseLeftButtonDown="OnEndDown" KeyDown="OnEndKey"
                    AutomationProperties.Name="{l:T share.trimEnd}">
                <Rectangle Width="2" Height="16" RadiusX="1" RadiusY="1" Fill="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
